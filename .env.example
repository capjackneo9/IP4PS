# ─── Public (sent to the browser) ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ip4ps.app

# Registry address on each network, from `npm run contracts:deploy`. Leave empty where not deployed.
NEXT_PUBLIC_CONTRACT_ADDRESS_POLYGON=
NEXT_PUBLIC_CONTRACT_ADDRESS_ETHEREUM=
NEXT_PUBLIC_CONTRACT_ADDRESS_SEPOLIA=
NEXT_PUBLIC_CONTRACT_ADDRESS_AMOY=

# Optional RPC endpoints (e.g. Alchemy/Infura URLs). Defaults are the chains' public RPCs, which are rate-limited.
NEXT_PUBLIC_RPC_POLYGON=
NEXT_PUBLIC_RPC_ETHEREUM=
NEXT_PUBLIC_RPC_SEPOLIA=
NEXT_PUBLIC_RPC_AMOY=

# WalletConnect Cloud project ID (cloud.reown.com). Enables MetaMask mobile, Rainbow, Ledger and WalletConnect.
# Without it, browser-extension wallets and Coinbase Wallet still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

NEXT_PUBLIC_ENABLE_TESTNETS=true
# Preferred IPFS gateway (others are tried as fallbacks).
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Local development only
NEXT_PUBLIC_ENABLE_LOCAL_CHAIN=false
NEXT_PUBLIC_CONTRACT_ADDRESS_LOCAL=
# Test-only wallet for the end-to-end test. NEVER enable in production.
NEXT_PUBLIC_E2E_MOCK_WALLET=false

# ─── Server only ───────────────────────────────────────────────────────────────
# Pinata JWT (app.pinata.cloud → API Keys). Without it, "Fingerprint + IPFS" storage is disabled.
PINATA_JWT=
# Optional: comma-separated wallets allowed to upload (empty = any wallet that signs).
IPFS_ALLOWED_ADDRESSES=

# ─── Contract deployment (scripts only, never commit a real key) ──────────────
# NETWORK=amoy DEPLOYER_PRIVATE_KEY=0x… RPC_URL=https://… npm run contracts:deploy
