{
  "name": "ip4ps",
  "version": "0.1.0",
  "private": true,
  "description": "IP4PS — Intellectual Property 4 Pillars System: blockchain-backed IP protection for independent artists",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contracts:compile": "tsx contracts/scripts/compile.ts",
    "contracts:test": "tsx contracts/scripts/compile.ts && vitest run --config vitest.contracts.config.ts",
    "chain": "hardhat node --hostname 127.0.0.1 --port 8545",
    "contracts:deploy": "tsx contracts/scripts/deploy.ts"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.106.1",
    "clsx": "^2.1.1",
    "hash-wasm": "^4.12.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "next": "15.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "server-only": "^0.0.1",
    "viem": "^2.57.16",
    "wagmi": "^2.19.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5",
    "hardhat": "^2.29.1",
    "postcss": "^8.5.32",
    "solc": "^0.8.28",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
